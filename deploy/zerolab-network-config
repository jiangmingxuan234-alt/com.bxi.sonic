#!/bin/bash
set -eu

ACTION=${1:-}
MODE=${ZEROLAB_NETWORK_MODE:-direct}
IP_BIN=${ZEROLAB_IP_BIN:-/usr/sbin/ip}
SYS_CLASS_NET_ROOT=${ZEROLAB_SYS_CLASS_NET_ROOT:-/sys/class/net}
SYSCTL_BIN=${ZEROLAB_SYSCTL_BIN:-/usr/sbin/sysctl}
SYSTEMD_NOTIFY_BIN=${ZEROLAB_SYSTEMD_NOTIFY_BIN:-/usr/bin/systemd-notify}
STATE_DIR=${ZEROLAB_NETWORK_STATE_DIR:-/run/zerolab-network}
RECONCILE_SECONDS=${ZEROLAB_RECONCILE_SECONDS:-1}
ALIAS_ADDRESS=
ALIAS_ETH=
ALIAS_WIFI=
ALIAS_ADDRESS_ORIGIN=
INSPECTED_ALIAS_PRESENT=0
INSPECTED_ORDINARY_IPV4_PRESENT=0

usage() {
    printf 'usage: %s {start|stop|run}\n' "$0" >&2
    printf '       %s validate-sender CONFIG_FILE\n' "$0" >&2
}

validate_mode() {
    case "$MODE" in
        ""|direct)
            MODE=direct
            ;;
        alias)
            :
            ;;
        *)
            printf 'expected direct or alias\n' >&2
            return 2
            ;;
    esac
}

validate_state_dir() {
    local resolved_state_dir

    case "$STATE_DIR" in
        /run/*|/tmp/*)
            ;;
        *)
            printf 'state directory must be under /run/* or /tmp/*\n' >&2
            return 2
            ;;
    esac
    case "$STATE_DIR" in
        /run/|/tmp/|*//*|*/./*|*/../*|*/.|*/..)
            printf 'state directory must be under /run/* or /tmp/*\n' >&2
            return 2
            ;;
    esac
    STATE_DIR=${STATE_DIR%/}
    if [[ -L "$STATE_DIR" ]]; then
        printf 'state directory must be under /run/* or /tmp/*\n' >&2
        return 2
    fi
    if ! resolved_state_dir=$(realpath -m -- "$STATE_DIR"); then
        printf 'state directory must be under /run/* or /tmp/*\n' >&2
        return 2
    fi
    case "$resolved_state_dir" in
        /run/*|/tmp/*)
            STATE_DIR=$resolved_state_dir
            ;;
        *)
            printf 'state directory must be under /run/* or /tmp/*\n' >&2
            return 2
            ;;
    esac
    if ! state_parent_chain_is_trusted; then
        printf 'state directory is not trusted\n' >&2
        return 2
    fi
}

validate_reconcile_seconds() {
    case "$RECONCILE_SECONDS" in
        ''|*[!0-9.]*|.*.*|*.*.*)
            printf 'reconciliation interval must be positive\n' >&2
            return 2
            ;;
    esac
    if ! awk "BEGIN { exit !($RECONCILE_SECONDS > 0) }" </dev/null; then
        printf 'reconciliation interval must be positive\n' >&2
        return 2
    fi
}

valid_ipv4() {
    local value=$1
    local octet
    local -a octets

    [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r -a octets <<< "$value"
    [[ ${#octets[@]} -eq 4 ]] || return 1
    for octet in "${octets[@]}"; do
        case "$octet" in
            [0-9]|[0-9][0-9]|[0-1][0-9][0-9]|2[0-4][0-9]|25[0-5])
                ;;
            *)
                return 1
                ;;
        esac
    done
}

valid_sender_ipv4() {
    local value=$1
    local octet
    local -a octets

    [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r -a octets <<< "$value"
    [[ ${#octets[@]} -eq 4 ]] || return 1
    for octet in "${octets[@]}"; do
        [[ "$octet" = 0 || "$octet" =~ ^[1-9][0-9]{0,2}$ ]] || return 1
        (( 10#$octet <= 255 )) || return 1
    done
}

invalid_sender_config() {
    printf 'invalid ZeroLab sender configuration\n' >&2
    return 2
}

validate_sender_config() {
    local config_file=$1
    local line
    local value
    local sender_count=0

    if [[ ! -e "$config_file" && ! -L "$config_file" ]]; then
        return 0
    fi
    if [[ ! -f "$config_file" || -L "$config_file" ]]; then
        invalid_sender_config
        return $?
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*# ]]; then
            continue
        fi
        if [[ "$line" =~ ^[[:space:]]*ZEROLAB_ALLOWED_SENDER($|[[:space:]=]) ]]; then
            ((sender_count += 1))
            if [[ $sender_count -ne 1 ]]; then
                invalid_sender_config
                return $?
            fi
            case "$line" in
                ZEROLAB_ALLOWED_SENDER=any)
                    ;;
                ZEROLAB_ALLOWED_SENDER=*)
                    value=${line#ZEROLAB_ALLOWED_SENDER=}
                    if ! valid_sender_ipv4 "$value"; then
                        invalid_sender_config
                        return $?
                    fi
                    ;;
                *)
                    invalid_sender_config
                    return $?
                    ;;
            esac
        fi
    done < "$config_file" || {
        invalid_sender_config
        return $?
    }
}

valid_interface() {
    local value=$1

    [[ -n "$value" && "$value" =~ ^[A-Za-z0-9_.:-]+$ ]]
}

valid_uint() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

valid_address() {
    local address=$1
    local address_ip

    case "$address" in
        */32)
            address_ip=${address%/32}
            ;;
        *)
            return 1
            ;;
    esac
    [[ "$address" = "$address_ip/32" ]] && valid_ipv4 "$address_ip"
}

path_is_owned_and_restricted() {
    local path=$1
    local kind=$2
    local restriction=$3
    local owner
    local permissions

    case "$kind" in
        directory)
            [[ -d "$path" && ! -L "$path" ]] || return 1
            ;;
        file)
            [[ -f "$path" && ! -L "$path" ]] || return 1
            ;;
        *)
            return 1
            ;;
    esac
    if ! owner=$(stat -c %u -- "$path") ||
        ! permissions=$(stat -c %a -- "$path")
    then
        return 1
    fi
    [[ "$owner" = "$EUID" && "$permissions" =~ ^[0-7]+$ ]] || return 1
    case "$restriction" in
        private)
            (( (8#$permissions & 8#077) == 0 ))
            ;;
        no_group_or_world_write)
            (( (8#$permissions & 8#022) == 0 ))
            ;;
        *)
            return 1
            ;;
    esac
}

tmp_root_is_trusted() {
    local owner
    local permissions

    [[ -d /tmp && ! -L /tmp ]] || return 1
    if ! owner=$(stat -c %u -- /tmp) ||
        ! permissions=$(stat -c %a -- /tmp)
    then
        return 1
    fi
    # 65534 is the mapped representation of host root in rootless test namespaces.
    case "$owner" in
        0|65534)
            ;;
        *)
            return 1
            ;;
    esac
    [[ "$permissions" =~ ^[0-7]+$ ]] || return 1
    (( (8#$permissions & 8#1000) != 0 ))
}

state_parent_chain_is_trusted() {
    local allowed_root
    local parent=${STATE_DIR%/*}

    case "$STATE_DIR" in
        /tmp/*)
            allowed_root=/tmp
            tmp_root_is_trusted || return 1
            ;;
        /run/*)
            allowed_root=/run
            path_is_owned_and_restricted /run directory no_group_or_world_write || return 1
            ;;
        *)
            return 1
            ;;
    esac
    while [[ "$parent" != "$allowed_root" ]]; do
        path_is_owned_and_restricted "$parent" directory no_group_or_world_write || return 1
        parent=${parent%/*}
    done
}

state_directory_is_trusted() {
    state_parent_chain_is_trusted &&
        path_is_owned_and_restricted "$STATE_DIR" directory private
}

state_file_is_trusted() {
    path_is_owned_and_restricted "$1" file private
}

inspect_interface_addresses() {
    local address=$1
    local interface=$2
    local output

    valid_address "$address" && valid_interface "$interface" || return 2
    if ! output=$("$IP_BIN" -4 address show dev "$interface"); then
        printf 'failed to inspect saved alias address\n' >&2
        return 2
    fi
    INSPECTED_ALIAS_PRESENT=0
    INSPECTED_ORDINARY_IPV4_PRESENT=0
    if printf '%s\n' "$output" | awk -v address="$address" \
        '$1 == "inet" && $2 == address { found = 1 } END { exit !found }'
    then
        INSPECTED_ALIAS_PRESENT=1
    fi
    if printf '%s\n' "$output" | awk -v address="$address" \
        '$1 == "inet" && $2 != address { found = 1 } END { exit !found }'
    then
        INSPECTED_ORDINARY_IPV4_PRESENT=1
    fi
}

address_present() {
    inspect_interface_addresses "$1" "$2" || return $?
    [[ "$INSPECTED_ALIAS_PRESENT" = 1 ]]
}

alias_interface_ready() {
    local interface=$1
    local carrier_file="$SYS_CLASS_NET_ROOT/$interface/carrier"
    local carrier

    valid_interface "$interface" || return 2
    if ! IFS= read -r carrier < "$carrier_file"; then
        printf 'failed to inspect Ethernet carrier\n' >&2
        return 2
    fi
    case "$carrier" in
        0)
            return 1
            ;;
        1)
            ;;
        *)
            printf 'invalid Ethernet carrier state\n' >&2
            return 2
            ;;
    esac
    [[ "$INSPECTED_ORDINARY_IPV4_PRESENT" = 1 ]]
}

read_state_value() {
    local filename=$1
    local name=$2
    local -a lines

    if ! state_file_is_trusted "$filename"; then
        printf 'invalid saved state: missing or unsafe %s\n' "$name" >&2
        return 1
    fi
    mapfile -t lines < "$filename"
    if [[ ${#lines[@]} -ne 1 || -z "${lines[0]}" ]]; then
        printf 'invalid saved state: %s must contain one nonempty line\n' "$name" >&2
        return 1
    fi
    printf '%s\n' "${lines[0]}"
}

write_state_value() {
    local directory=$1
    local filename=$2
    local value=$3

    (
        umask 077
        printf '%s\n' "$value" > "$directory/$filename"
    )
}

validate_alias_config() {
    local alias_ip=${ZEROLAB_ALIAS_IP:-}
    local ethernet=${ZEROLAB_ETH:-}
    local wifi=${ZEROLAB_WIFI:-}

    if ! valid_ipv4 "$alias_ip"; then
        printf 'invalid ZEROLAB_ALIAS_IP\n' >&2
        return 2
    fi
    if ! valid_interface "$ethernet"; then
        printf 'invalid ZEROLAB_ETH\n' >&2
        return 2
    fi
    if ! valid_interface "$wifi"; then
        printf 'invalid ZEROLAB_WIFI\n' >&2
        return 2
    fi
    ALIAS_ADDRESS="$alias_ip/32"
    ALIAS_ETH=$ethernet
    ALIAS_WIFI=$wifi
}

validate_state_entries() {
    local entry
    local name

    for entry in "$STATE_DIR"/* "$STATE_DIR"/.[!.]* "$STATE_DIR"/..?*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name=${entry##*/}
        case "$name" in
            schema|mode|address|eth|wifi|arp_ignore.old|address.origin|active)
                ;;
            *)
                printf 'invalid saved state: unknown entry %s\n' "$name" >&2
                return 1
                ;;
        esac
        if ! state_file_is_trusted "$entry"; then
            printf 'invalid saved state: unsafe entry %s\n' "$name" >&2
            return 1
        fi
    done
}

state_context_is_trusted() {
    state_directory_is_trusted && validate_state_entries
}

remove_complete_state_directory() {
    local directory=$1
    local name

    for name in schema mode address eth wifi arp_ignore.old address.origin active; do
        if ! rm -- "$directory/$name"; then
            printf 'failed to remove saved state entry %s\n' "$name" >&2
            return 1
        fi
    done
    if ! rmdir -- "$directory"; then
        printf 'failed to remove saved state\n' >&2
        return 1
    fi
}

remove_partial_state_directory() {
    local directory=$1
    local name

    for name in schema mode address eth wifi arp_ignore.old address.origin active; do
        if [[ -e "$directory/$name" || -L "$directory/$name" ]] &&
            ! rm -- "$directory/$name"
        then
            return 1
        fi
    done
    rmdir -- "$directory"
}

discard_unconfirmed_add_state() {
    if ! write_state_value "$STATE_DIR" active unconfirmed-add; then
        printf 'failed to quarantine unconfirmed alias state\n' >&2
        return 1
    fi
    if ! state_context_is_trusted ||
        ! remove_complete_state_directory "$STATE_DIR"
    then
        printf 'failed to discard unconfirmed alias state\n' >&2
        return 1
    fi
}

prepare_alias_state() {
    local arp_key="net.ipv4.conf.${ALIAS_WIFI}.arp_ignore"
    local arp_ignore_old
    local address_status
    local state_new
    local state_entry

    if ! state_parent_chain_is_trusted; then
        printf 'state directory is not trusted\n' >&2
        return 1
    fi

    if address_present "$ALIAS_ADDRESS" "$ALIAS_ETH"; then
        ALIAS_ADDRESS_ORIGIN=preexisting
    else
        address_status=$?
        if [[ $address_status -ne 1 ]]; then
            return "$address_status"
        fi
        ALIAS_ADDRESS_ORIGIN=added
    fi

    if ! arp_ignore_old=$("$SYSCTL_BIN" -n "$arp_key"); then
        printf 'failed to read %s\n' "$arp_key" >&2
        return 1
    fi
    if ! valid_uint "$arp_ignore_old"; then
        printf 'invalid %s value\n' "$arp_key" >&2
        return 1
    fi

    if [[ -e "$STATE_DIR" || -L "$STATE_DIR" ]]; then
        printf 'saved state already exists; refusing to replace it\n' >&2
        return 1
    fi
    state_new="${STATE_DIR}.new.$$"
    if ! (umask 077; mkdir "$state_new"); then
        printf 'failed to create saved state\n' >&2
        return 1
    fi
    if ! path_is_owned_and_restricted "$state_new" directory private; then
        remove_partial_state_directory "$state_new" || true
        printf 'failed to create trusted saved state\n' >&2
        return 1
    fi
    if ! write_state_value "$state_new" schema 1 ||
        ! write_state_value "$state_new" mode alias ||
        ! write_state_value "$state_new" address "$ALIAS_ADDRESS" ||
        ! write_state_value "$state_new" eth "$ALIAS_ETH" ||
        ! write_state_value "$state_new" wifi "$ALIAS_WIFI" ||
        ! write_state_value "$state_new" arp_ignore.old "$arp_ignore_old" ||
        ! write_state_value "$state_new" address.origin "$ALIAS_ADDRESS_ORIGIN" ||
        ! write_state_value "$state_new" active 1
    then
        remove_partial_state_directory "$state_new" || true
        printf 'failed to write saved state\n' >&2
        return 1
    fi
    for state_entry in schema mode address eth wifi arp_ignore.old address.origin active; do
        if ! state_file_is_trusted "$state_new/$state_entry"; then
            remove_partial_state_directory "$state_new" || true
            printf 'failed to create trusted saved state\n' >&2
            return 1
        fi
    done
    if ! mv -T -- "$state_new" "$STATE_DIR"; then
        remove_partial_state_directory "$state_new" || true
        printf 'failed to install saved state\n' >&2
        return 1
    fi
}

cleanup_saved_state() {
    local schema
    local saved_mode
    local address
    local ethernet
    local wifi
    local arp_ignore_old
    local address_origin
    local active
    local arp_key
    local address_status
    local readiness_status
    local cleanup_failed=0

    if [[ ! -e "$STATE_DIR" && ! -L "$STATE_DIR" ]]; then
        return 0
    fi
    if [[ ! -d "$STATE_DIR" || -L "$STATE_DIR" ]]; then
        printf 'invalid saved state: state path is not a directory\n' >&2
        return 1
    fi
    if ! state_directory_is_trusted; then
        printf 'invalid saved state: state path is not trusted\n' >&2
        return 1
    fi
    validate_state_entries || return 1
    if ! schema=$(read_state_value "$STATE_DIR/schema" schema) ||
        ! saved_mode=$(read_state_value "$STATE_DIR/mode" mode) ||
        ! address=$(read_state_value "$STATE_DIR/address" address) ||
        ! ethernet=$(read_state_value "$STATE_DIR/eth" eth) ||
        ! wifi=$(read_state_value "$STATE_DIR/wifi" wifi) ||
        ! arp_ignore_old=$(read_state_value "$STATE_DIR/arp_ignore.old" arp_ignore.old) ||
        ! address_origin=$(read_state_value "$STATE_DIR/address.origin" address.origin) ||
        ! active=$(read_state_value "$STATE_DIR/active" active)
    then
        return 1
    fi
    if [[ "$schema" != 1 || "$saved_mode" != alias || "$active" != 1 ]]; then
        printf 'invalid saved state: unsupported schema, mode, or activity\n' >&2
        return 1
    fi
    if ! valid_address "$address" || ! valid_interface "$ethernet" ||
        ! valid_interface "$wifi" || ! valid_uint "$arp_ignore_old"
    then
        printf 'invalid saved state: unsafe rollback value\n' >&2
        return 1
    fi
    case "$address_origin" in
        added|preexisting)
            ;;
        *)
            printf 'invalid saved state: unknown address origin\n' >&2
            return 1
            ;;
    esac

    arp_key="net.ipv4.conf.${wifi}.arp_ignore"
    if ! state_context_is_trusted; then
        printf 'invalid saved state: state changed before rollback\n' >&2
        return 1
    fi
    if ! "$SYSCTL_BIN" -w "$arp_key=$arp_ignore_old"; then
        printf 'failed to restore %s\n' "$arp_key" >&2
        cleanup_failed=1
    fi

    if ! state_context_is_trusted; then
        printf 'invalid saved state: state changed during rollback\n' >&2
        return 1
    fi
    if ! inspect_interface_addresses "$address" "$ethernet"; then
        address_status=2
        cleanup_failed=1
    elif [[ "$INSPECTED_ALIAS_PRESENT" = 1 ]]; then
        address_status=0
    else
        address_status=1
    fi
    if [[ $address_status -eq 0 ]]; then
        case "$address_origin" in
            added)
                if ! "$IP_BIN" address del "$address" dev "$ethernet"; then
                    printf 'failed to remove saved alias address\n' >&2
                    cleanup_failed=1
                fi
                ;;
            preexisting)
                ;;
        esac
    elif [[ $address_status -eq 1 && "$address_origin" = preexisting ]]; then
        if alias_interface_ready "$ethernet"; then
            if ! "$IP_BIN" address add "$address" dev "$ethernet"; then
                printf 'failed to restore preexisting alias address\n' >&2
                cleanup_failed=1
            fi
        else
            readiness_status=$?
            if [[ $readiness_status -eq 1 || $readiness_status -eq 2 ]]; then
                printf 'preexisting alias restoration deferred until ordinary Ethernet is ready\n' >&2
            fi
            cleanup_failed=1
        fi
    fi

    if [[ $cleanup_failed -ne 0 ]]; then
        printf 'saved state rollback incomplete; retaining state\n' >&2
        return 1
    fi
    if ! state_context_is_trusted ||
        ! remove_complete_state_directory "$STATE_DIR"
    then
        printf 'failed to remove saved state\n' >&2
        return 1
    fi
}

reconcile_alias_address() {
    local address=$1
    local ethernet=$2
    local address_origin=$3
    local readiness

    if ! inspect_interface_addresses "$address" "$ethernet"; then
        return 1
    fi
    if alias_interface_ready "$ethernet"; then
        readiness=ready
    else
        case $? in
            1) readiness=unready ;;
            *) return 1 ;;
        esac
    fi

    case "$readiness:$address_origin:$INSPECTED_ALIAS_PRESENT" in
        ready:*:1|unready:preexisting:*|unready:added:0)
            return 0
            ;;
        ready:*:0)
            state_context_is_trusted || return 1
            "$IP_BIN" address add "$address" dev "$ethernet" || return 1
            printf 'ZeroLab alias address restored\n' >&2
            ;;
        unready:added:1)
            state_context_is_trusted || return 1
            "$IP_BIN" address del "$address" dev "$ethernet" || return 1
            printf 'ZeroLab alias withdrawn while ordinary Ethernet is unavailable\n' >&2
            ;;
        *)
            return 1
            ;;
    esac
}

reconcile_alias() {
    local schema
    local saved_mode
    local address
    local ethernet
    local wifi
    local arp_ignore_old
    local address_origin
    local active
    local arp_key
    local arp_ignore_current
    local address_failed=0
    local arp_failed=0
    local repaired=0

    if [[ ! -e "$STATE_DIR" && ! -L "$STATE_DIR" ]]; then
        printf 'invalid saved state: missing state for alias reconciliation\n' >&2
        return 1
    fi
    if ! state_context_is_trusted; then
        printf 'invalid saved state: state path is not trusted\n' >&2
        return 1
    fi
    if ! schema=$(read_state_value "$STATE_DIR/schema" schema) ||
        ! saved_mode=$(read_state_value "$STATE_DIR/mode" mode) ||
        ! address=$(read_state_value "$STATE_DIR/address" address) ||
        ! ethernet=$(read_state_value "$STATE_DIR/eth" eth) ||
        ! wifi=$(read_state_value "$STATE_DIR/wifi" wifi) ||
        ! arp_ignore_old=$(read_state_value "$STATE_DIR/arp_ignore.old" arp_ignore.old) ||
        ! address_origin=$(read_state_value "$STATE_DIR/address.origin" address.origin) ||
        ! active=$(read_state_value "$STATE_DIR/active" active)
    then
        return 1
    fi
    if [[ "$schema" != 1 || "$saved_mode" != alias || "$active" != 1 ]]; then
        printf 'invalid saved state: unsupported schema, mode, or activity\n' >&2
        return 1
    fi
    if ! valid_address "$address" || ! valid_interface "$ethernet" ||
        ! valid_interface "$wifi" || ! valid_uint "$arp_ignore_old"
    then
        printf 'invalid saved state: unsafe reconciliation value\n' >&2
        return 1
    fi
    case "$address_origin" in
        added|preexisting)
            ;;
        *)
            printf 'invalid saved state: unknown address origin\n' >&2
            return 1
            ;;
    esac

    arp_key="net.ipv4.conf.${wifi}.arp_ignore"
    if ! reconcile_alias_address "$address" "$ethernet" "$address_origin"; then
        address_failed=1
    fi

    if ! arp_ignore_current=$("$SYSCTL_BIN" -n "$arp_key"); then
        printf 'failed to read %s\n' "$arp_key" >&2
        arp_failed=1
    elif ! valid_uint "$arp_ignore_current"; then
        printf 'invalid %s value\n' "$arp_key" >&2
        arp_failed=1
    elif [[ "$arp_ignore_current" != 1 ]]; then
        if ! state_context_is_trusted; then
            printf 'invalid saved state: state changed before ARP repair\n' >&2
            arp_failed=1
        elif ! "$SYSCTL_BIN" -w "$arp_key=1"; then
            printf 'failed to repair %s\n' "$arp_key" >&2
            arp_failed=1
        else
            repaired=1
        fi
    fi
    if [[ $repaired -eq 1 ]]; then
        printf 'ZeroLab alias reconciliation repaired\n' >&2
    fi
    if [[ $address_failed -ne 0 || $arp_failed -ne 0 ]]; then
        return 1
    fi
    return 0
}

start_alias() {
    local arp_key
    local readiness_status

    validate_alias_config || return $?
    prepare_alias_state || return 1

    if ! state_context_is_trusted; then
        printf 'saved state is not trusted before alias add\n' >&2
        return 1
    fi
    if alias_interface_ready "$ALIAS_ETH"; then
        if [[ "$ALIAS_ADDRESS_ORIGIN" = added ]]; then
            if ! "$IP_BIN" address add "$ALIAS_ADDRESS" dev "$ALIAS_ETH"; then
                printf 'failed to add alias address\n' >&2
                discard_unconfirmed_add_state || true
                return 1
            fi
        fi
    else
        readiness_status=$?
        if [[ $readiness_status -eq 1 || $readiness_status -eq 2 ]]; then
            printf 'waiting for ordinary Ethernet network\n' >&2
        else
            return "$readiness_status"
        fi
    fi

    arp_key="net.ipv4.conf.${ALIAS_WIFI}.arp_ignore"
    if ! state_context_is_trusted; then
        printf 'saved state is not trusted before ARP update\n' >&2
        return 1
    fi
    if ! "$SYSCTL_BIN" -w "$arp_key=1"; then
        printf 'failed to set %s\n' "$arp_key" >&2
        cleanup_saved_state || true
        return 1
    fi
}

start_network() {
    if [[ -e "$STATE_DIR" || -L "$STATE_DIR" ]]; then
        cleanup_saved_state || return 1
    fi
    case "$MODE" in
        direct)
            return 0
            ;;
        alias)
            start_alias
            ;;
    esac
}

stop_network() {
    cleanup_saved_state
}

run_network() {
    validate_reconcile_seconds
    trap 'cleanup_saved_state; exit $?' INT TERM
    start_network
    "$SYSTEMD_NOTIFY_BIN" --ready
    while :; do
        sleep "$RECONCILE_SECONDS"
        if [ "$MODE" = alias ] && ! reconcile_alias; then
            echo "ZeroLab alias reconciliation failed; retrying" >&2
        fi
    done
}

if [[ "$ACTION" = validate-sender ]]; then
    if [[ $# -ne 2 ]]; then
        usage
        exit 2
    fi
    validate_sender_config "$2"
    exit $?
fi

case "$ACTION" in
    start|stop|run)
        ;;
    *)
        usage
        exit 2
        ;;
esac

validate_mode
validate_state_dir

case "$ACTION" in
    start)
        start_network
        ;;
    stop)
        stop_network
        ;;
    run)
        run_network
        ;;
esac
